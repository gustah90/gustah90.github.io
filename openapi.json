{
  "openapi": "3.1.0",
  "info": {
    "title": "gustavo.dev public endpoints",
    "version": "0.11.0",
    "description": "Static portal. No backend, authenticated API, SSE or WebSocket."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/health.json": {
      "get": {
        "summary": "Build readiness",
        "description": "GET/HEAD only. Static public data; no authentication or write operation.",
        "responses": {
          "200": {
            "description": "Public static representation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "version"],
                  "properties": {
                    "status": { "type": "string", "const": "ok" },
                    "version": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": { "description": "Route does not exist" }
        }
      }
    },
    "/version.json": {
      "get": {
        "summary": "Version and revision",
        "description": "GET/HEAD only. Static public data; no authentication or write operation.",
        "responses": {
          "200": {
            "description": "Public static representation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["version", "revision"],
                  "properties": {
                    "version": { "type": "string" },
                    "revision": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": { "description": "Route does not exist" }
        }
      }
    },
    "/{lang}/posts.json": {
      "get": {
        "summary": "Public article index",
        "description": "GET/HEAD only. Static public data; no authentication or write operation.",
        "responses": {
          "200": {
            "description": "Public static representation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "locale",
                      "slug",
                      "title",
                      "excerpt",
                      "date",
                      "tags"
                    ],
                    "properties": {
                      "locale": {
                        "type": "string",
                        "enum": ["pt", "en", "es"]
                      },
                      "slug": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      },
                      "title": { "type": "string" },
                      "excerpt": { "type": "string" },
                      "date": { "type": "string", "format": "date" },
                      "tags": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Route does not exist" }
        }
      },
      "parameters": [
        {
          "name": "lang",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "enum": ["pt", "en", "es"] }
        }
      ]
    },
    "/openapi.json": {
      "get": {
        "summary": "OpenAPI contract",
        "description": "GET/HEAD only. Static public data; no authentication or write operation.",
        "responses": {
          "200": {
            "description": "Public static representation",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          },
          "404": { "description": "Route does not exist" }
        }
      }
    },
    "/api-collection.json": {
      "get": {
        "summary": "Postman / Insomnia collection",
        "description": "GET/HEAD only. Static public data; no authentication or write operation.",
        "responses": {
          "200": {
            "description": "Public static representation",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          },
          "404": { "description": "Route does not exist" }
        }
      }
    },
    "/robots.txt": {
      "get": {
        "summary": "Crawler rules",
        "description": "GET/HEAD only. Static public data; no authentication or write operation.",
        "responses": {
          "200": {
            "description": "Public static representation",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          },
          "404": { "description": "Route does not exist" }
        }
      }
    },
    "/sitemap.xml": {
      "get": {
        "summary": "Public sitemap",
        "description": "GET/HEAD only. Static public data; no authentication or write operation.",
        "responses": {
          "200": {
            "description": "Public static representation",
            "content": { "application/xml": { "schema": { "type": "string" } } }
          },
          "404": { "description": "Route does not exist" }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Language selector",
        "description": "GET/HEAD only. Static public data; no authentication or write operation.",
        "responses": {
          "200": {
            "description": "Public static representation",
            "content": { "text/html": { "schema": { "type": "string" } } }
          },
          "404": { "description": "Route does not exist" }
        }
      }
    },
    "/{lang}/": {
      "get": {
        "summary": "Localized home",
        "description": "GET/HEAD only. Static public data; no authentication or write operation.",
        "responses": {
          "200": {
            "description": "Public static representation",
            "content": { "text/html": { "schema": { "type": "string" } } }
          },
          "404": { "description": "Route does not exist" }
        }
      },
      "parameters": [
        {
          "name": "lang",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "enum": ["pt", "en", "es"] }
        }
      ]
    },
    "/{lang}/docs/": {
      "get": {
        "summary": "Localized documentation",
        "description": "GET/HEAD only. Static public data; no authentication or write operation.",
        "responses": {
          "200": {
            "description": "Public static representation",
            "content": { "text/html": { "schema": { "type": "string" } } }
          },
          "404": { "description": "Route does not exist" }
        }
      },
      "parameters": [
        {
          "name": "lang",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "enum": ["pt", "en", "es"] }
        }
      ]
    },
    "/{lang}/accessibility/": {
      "get": {
        "summary": "Accessibility statement",
        "description": "GET/HEAD only. Static public data; no authentication or write operation.",
        "responses": {
          "200": {
            "description": "Public static representation",
            "content": { "text/html": { "schema": { "type": "string" } } }
          },
          "404": { "description": "Route does not exist" }
        }
      },
      "parameters": [
        {
          "name": "lang",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "enum": ["pt", "en", "es"] }
        }
      ]
    },
    "/docs/api/": {
      "get": {
        "summary": "Swagger UI",
        "description": "GET/HEAD only. Static public data; no authentication or write operation.",
        "responses": {
          "200": {
            "description": "Public static representation",
            "content": { "text/html": { "schema": { "type": "string" } } }
          },
          "404": { "description": "Route does not exist" }
        }
      }
    },
    "/{lang}/posts/{slug}/": {
      "x-conditional-content": true,
      "get": {
        "summary": "Read an approved localized article",
        "description": "Generated only for approved Markdown entries with a publication date already reached. Drafts and missing translations have no route. A placeholder slug will return 404.",
        "parameters": [
          {
            "name": "lang",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["pt", "en", "es"] }
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Article HTML",
            "content": { "text/html": { "schema": { "type": "string" } } }
          },
          "404": { "description": "No approved article at this permalink" }
        }
      }
    },
    "/changelog.txt": {
      "get": {
        "summary": "Public changelog",
        "responses": {
          "200": {
            "description": "Public changelog",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/security.txt": {
      "get": {
        "summary": "Public security policy",
        "responses": {
          "200": {
            "description": "Public security policy",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/{lang}/about/": {
      "get": {
        "summary": "Author biography",
        "parameters": [
          {
            "name": "lang",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["en", "pt", "es"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved public content",
            "content": { "text/html": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/{lang}/archive/": {
      "get": {
        "summary": "Article archive by year",
        "parameters": [
          {
            "name": "lang",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["en", "pt", "es"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved public content",
            "content": { "text/html": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/{lang}/tags/": {
      "get": {
        "summary": "Tag counts",
        "parameters": [
          {
            "name": "lang",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["en", "pt", "es"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved public content",
            "content": { "text/html": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/{lang}/tags/{tag}/": {
      "get": {
        "summary": "Approved articles by tag",
        "parameters": [
          {
            "name": "lang",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["en", "pt", "es"] }
          },
          {
            "name": "tag",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved public content",
            "content": { "text/html": { "schema": { "type": "string" } } }
          }
        }
      },
      "x-conditional-content": true
    },
    "/{lang}/rss.xml": {
      "get": {
        "summary": "Localized RSS feed",
        "parameters": [
          {
            "name": "lang",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["en", "pt", "es"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved public content",
            "content": {
              "application/rss+xml": { "schema": { "type": "string" } }
            }
          }
        }
      }
    },
    "/{lang}/older-posts/": {
      "get": {
        "summary": "Older posts with optional infinite scroll",
        "parameters": [
          {
            "name": "lang",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["en", "pt", "es"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved public content",
            "content": { "text/html": { "schema": { "type": "string" } } }
          }
        },
        "description": "Localized approved article catalog. Loads finite batches locally with optional infinite scroll and an accessible manual load button. The home page is limited to four recent posts."
      }
    },
    "/giscus.json": {
      "get": {
        "summary": "Giscus allowed origins",
        "description": "Public provider configuration; no tokens or credentials. Comments are hosted externally in GitHub Discussions.",
        "responses": {
          "200": {
            "description": "Allowed embedding origins and comment order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["origins", "defaultCommentOrder"],
                  "properties": {
                    "origins": {
                      "type": "array",
                      "items": { "type": "string", "format": "uri" }
                    },
                    "defaultCommentOrder": {
                      "type": "string",
                      "enum": ["oldest", "newest"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
